# Dependencies
node_modules/

# Secrets — server/.env holds a real Dune API key; server/.env.example (no real
# values, just documents the variables) is meant to be committed and is NOT
# matched by this pattern.
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Local Claude Code session state — not project source.
.claude/

# Project working notes for Claude Code — internal review history, not meant
# for the public repo. Stays on disk locally; just not tracked/pushed.
CLAUDE.md

# Local project summary doc — not meant for the public repo.
*.docx
