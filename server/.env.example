PORT=8787

HORIZON_PUBNET_URL=https://horizon.stellar.org
HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org

SOROBAN_PUBNET_RPC=https://mainnet.sorobanrpc.com
SOROBAN_TESTNET_RPC=https://soroban-testnet.stellar.org

# Used as a best-effort optimization in ledgerTime.js (with a built-in fallback
# if unset/unreachable) — not a hard dependency.
STELLAR_EXPERT_URL=https://api.stellar.expert

# Optional — powers the all-time Soroban asset-movement stat on the Smart Contracts
# page. Get a free key at dune.com, then save a query against stellar.history_operations
# / stellar.history_effects (see README) and put its ID in DUNE_QUERY_ID.
DUNE_API_KEY=
DUNE_QUERY_ID=
# Optional — day-bucketed Soroswap call-volume trend, see CLAUDE.md.
DUNE_SOROSWAP_TREND_QUERY_ID=
