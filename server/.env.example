PORT=8787

HORIZON_PUBNET_URL=https://horizon.stellar.org
HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org

SOROBAN_PUBNET_RPC=https://mainnet.sorobanrpc.com
SOROBAN_TESTNET_RPC=https://soroban-testnet.stellar.org

# Used as a best-effort optimization in ledgerTime.js (with a built-in fallback
# if unset/unreachable) — not a hard dependency.
STELLAR_EXPERT_URL=https://api.stellar.expert

# Optional — powers the all-time Soroban asset-movement stat on the Smart Contracts
# page. Get a free key at dune.com, then save a query against stellar.history_operations
# / stellar.history_effects (see README) and put its ID in DUNE_QUERY_ID.
DUNE_API_KEY=
DUNE_QUERY_ID=
# Optional — day-bucketed Soroswap call-volume trend, see README's Setup section.
DUNE_SOROSWAP_TREND_QUERY_ID=
# Optional — day-bucketed Soroswap function-name breakdown, see README's Setup section.
DUNE_SOROSWAP_FUNCTIONS_QUERY_ID=
# Optional — network-wide (all Soroban contracts) trade-function breakdown, see
# README's Setup section. This one's a heavy query (~19 min to execute).
DUNE_NETWORK_TRADES_QUERY_ID=
# Optional — day-bucketed account creation/closure trend on the Network Growth
# page, see README's Setup section.
DUNE_ACCOUNT_GROWTH_QUERY_ID=
# Optional — per-asset trustline growth breakdown on the Network Growth page,
# see README's Setup section.
DUNE_TRUSTLINE_GROWTH_QUERY_ID=
